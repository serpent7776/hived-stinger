{
  "rules": [
    {
      "name": "large-hive-transfer",
      "match": "op_type = transfer and symbol = \"HIVE\" and amount > 1000000",
      "exec": { "type": "socket" }
    },
    {
      "name": "alice-activity",
      "match": "\"alice\" in impacted_accounts and not is_virtual",
      "exec": { "type": "log" }
    },
    {
      "name": "shop-paid",
      "match": "op_type in (transfer, fill_recurrent_transfer) and to = \"shop\"",
      "exec": { "type": "socket" }
    },
    {
      "name": "splinterlands-market",
      "match": "op_type = custom_json and custom_id = \"sm_market\"",
      "exec": { "type": "log" }
    },
    {
      "name": "team-rewards",
      "match": "op_type in (author_reward, curation_reward) and impacted_accounts one of (\"alice\", \"bob\", \"carol\")",
      "exec": { "type": "socket" }
    },
    {
      "name": "my-witness-produced",
      "match": "op_type = producer_reward and \"mywitness\" in impacted_accounts",
      "exec": { "type": "socket" },
      "delivery": "head"
    }
  ]
}
